{
  "name": "authormark-watch",
  "version": "2.0.0",
  "description": "Zero-dependency cross-repo vulnerability scanner, security monitor, and repository tracker.",
  "type": "module",
  "bin": {
    "authormark-watch": "bot.mjs",
    "authormark-bot": "bot.mjs"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:watch": "node --test --watch",
    "watch": "node bot.mjs",
    "audit": "node bot.mjs --audit --dry-run",
    "transform": "node bot.mjs --transform",
    "dependabot": "node bot.mjs --dependabot",
    "webhook": "node bot.mjs webhook",
    "bot": "node bot.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bot.mjs",
    "lib/",
    "watch.sh",
    "bot.config.json"
  ],
  "keywords": [
    "security",
    "vulnerability-scanner",
    "osv",
    "secret-scanning",
    "github-actions",
    "repo-monitor"
  ],
  "author": "Srinivasan Vijayaraghavan <srinivasan.shyam2000@gmail.com> (https://github.com/Srinivasan-78)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Srinivasan-78/authormark-watch.git"
  },
  "dependencies": {},
  "devDependencies": {}
}
